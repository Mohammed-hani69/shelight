# نسخة من قيم البيئة — انسخه إلى .env واملأ القيم الحقيقية. لا تُرفع .env أبداً.
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_APP=run.py

# قاعدة البيانات
# SQLite للتطوير؛ في الإنتاج استخدم PostgreSQL/MySQL عبر DATABASE_URL.
DATABASE_URL=sqlite:///dev.db

# أسرار — ولّد قيماً عشوائية طويلة في الإنتاج
SECRET_KEY=dev-only-secret-key
JWT_SECRET_KEY=dev-only-jwt-secret-key
JWT_ACCESS_HOURS=12

# CORS — نطاقات الواجهة المسموحة (localhost و 127.0.0.1 أصلان مختلفان للمتصفح)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# عنوان API سريع
SARIEE_API_URL=https://api.shipping.sariee.com
