# نسخة من قيم البيئة — انسخه إلى .env واملأ القيم الحقيقية. لا تُرفع .env أبداً.
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_APP=run.py

# قاعدة البيانات
# SQLite للتطوير؛ في الإنتاج استخدم PostgreSQL/MySQL عبر DATABASE_URL.
DATABASE_URL=sqlite:///dev.db

# أسرار — ولّد قيماً عشوائية طويلة في الإنتاج
SECRET_KEY=dev-only-secret-key
JWT_SECRET_KEY=dev-only-jwt-secret-key
JWT_ACCESS_HOURS=12

# CORS — نطاقات الواجهة المسموحة (localhost و 127.0.0.1 أصلان مختلفان للمتصفح)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Bosta webhook ---------------------------------------------------------
# Bosta لا ترسل توقيعاً (HMAC). الطريقة الرسمية: ترويسة مخصّصة يختار التاجر
# اسمها وقيمتها في لوحة Bosta (Settings -> API Integration -> Webhook)، ويرسلها
# Bosta مع كل حدث.
#
# ضع نفس القيمة في الاثنين. اتركهما فارغين في التطوير: الـ endpoint يرفض كل
# الطلبات (503) إذا لم يُضبط السر — أفضل من قبول مصادر مجهولة.
#
# المرجع: https://docs.bosta.co/docs/how-to/get-delivery-status-via-webhook/
BOSTA_WEBHOOK_AUTH_HEADER=X-Bosta-Webhook-Token
BOSTA_WEBHOOK_AUTH_TOKEN=
