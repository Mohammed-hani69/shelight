# ---------------------------------------------------------------
# SHE LIGHT — shared environment example
# Copy to .env and fill in real values. NEVER commit .env
# ---------------------------------------------------------------

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Backend (Flask)
DATABASE_URL=sqlite:///shelight.db
SECRET_KEY=change-me-to-a-long-random-secret
JWT_SECRET_KEY=change-me-to-another-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FLASK_ENV=development

# Sariee API base URL; credentials are managed in the admin dashboard and encrypted at rest.
SARIEE_API_URL=https://api.shipping.sariee.com
