# ---------------------------------------------------------------
# SHE LIGHT — shared environment example
# Copy to .env and fill in real values. NEVER commit .env
# ---------------------------------------------------------------

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Backend (Flask)
DATABASE_URL=sqlite:///shelight.db
SECRET_KEY=change-me-to-a-long-random-secret
JWT_SECRET_KEY=change-me-to-another-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FLASK_ENV=development

# Shipping / Bosta (admin-managed credentials live in DB and are encrypted at rest)
BOSTA_API_URL=

# Bosta webhook auth — Bosta لا ترسل توقيعاً (HMAC)، بل ترويسة مخصّصة يختار
# التاجر اسمها وقيمتها في لوحة Bosta (Settings -> API Integration -> Webhook).
# اتركهما فارغين في التطوير: الـ endpoint يرفض كل الطلبات عند غيابهما.
# المرجع: https://docs.bosta.co/docs/how-to/get-delivery-status-via-webhook/
BOSTA_WEBHOOK_AUTH_HEADER=X-Bosta-Webhook-Token
BOSTA_WEBHOOK_AUTH_TOKEN=
# BOSTA_WEBHOOK_SECRET   ← متروك عمداً: Bosta لا تدعم HMAC، ولم يعد يُقرأ.

SHIPPING_ENCRYPTION_KEY=
